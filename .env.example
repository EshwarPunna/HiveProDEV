# LLM provider used for explanation generation + (optional) agentic ranking.
# "groq" (default, free tier, fast) | "gemini" | "none" (fully offline, uses
# deterministic template explanations — the system still runs and produces
# a complete, correct top-5 with zero API keys configured)
LLM_PROVIDER=groq

# Required if LLM_PROVIDER=groq. Get a free key at https://console.groq.com
# Default model: openai/gpt-oss-120b — open-weight, OpenAI-compatible, and (as of
# Aug 2026) the highest free-tier daily token budget on Groq (200K TPD vs 100K for
# llama-3.3-70b-versatile). Swap to llama-3.3-70b-versatile if you prefer Meta's model.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Required if LLM_PROVIDER=gemini. Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# "deterministic" (default, see scoring.py) | "agentic" (see agent_ranker.py)
RANKING_MODE=deterministic

PORT=8000
